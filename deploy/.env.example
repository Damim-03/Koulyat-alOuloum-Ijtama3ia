# ============================================================
# منصة مذكرتي — server settings for deploy/compose.yaml
# ============================================================
#
# Copy to deploy/.env and fill in. That file holds secrets: it is ignored by
# git and kept out of the image (.dockerignore). Keep it readable by you only:
#   chmod 600 .env
#
# Every secret below is generated separately — never reuse one:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# (URL-safe characters only: DB_PASSWORD goes into an address as it is.)
#
# The platform REFUSES TO START if a secret is missing, shorter than 32
# characters, or left as a placeholder.

# ── Address ─────────────────────────────────────────────────
# The domain people type, without https:// — its DNS A record must point at
# this machine's public address, and ports 80 and 443 must reach it.
# To try everything on this machine first: DOMAIN=localhost
DOMAIN=memoires.example.com
# Let's Encrypt writes here if the certificate is about to expire unrenewed.
ACME_EMAIL=you@example.com

# Only when ports 80/443 are taken by something else (another web server):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# PUBLIC_ORIGIN=https://localhost:8443
# Only for a trial that must stay on this machine:
# LISTEN_ADDRESS=127.0.0.1

# ── Or: your domain through a permanent Cloudflare Tunnel ───
# No port opened to the internet, works behind CGNAT. The domain is on
# Cloudflare; the tunnel's route (Published application) points at
# http://app:3000. caddy then stays on this machine only, and the address
# people type is PUBLIC_ORIGIN. The tunnel's token goes in its own file,
# deploy/.env.cloudflared (one line: TUNNEL_TOKEN=…, chmod 600), never here:
# this file is handed to the app too.
# COMPOSE_PROFILES=cloudflare
# PUBLIC_ORIGIN=https://memoires.your-domain.com
# DOMAIN=localhost
# LISTEN_ADDRESS=127.0.0.1

# ── Database ────────────────────────────────────────────────
DB_PASSWORD=

# ── Sessions ────────────────────────────────────────────────
# Two different values. SESSION_SECRET also encrypts the administrators'
# two-step keys: changing it later means every administrator sets theirs up
# again (npm run reset-2fa).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# ── Outgoing mail (password reset, security alerts) ─────────
# Without SMTP_HOST, mail is off and "forgot my password" says so.
# Gmail for testing (an app password, see Backend/.env.example):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="منصة مذكرتي <the.account@gmail.com>"

# ── Optional ────────────────────────────────────────────────
# Every other setting in Backend/.env.example can be added here too, e.g.:
# REQUIRE_STUDENT_ACTIVATION=false
# ADMIN_SESSION_HOURS=8
#
# Already set by compose.yaml, do not repeat: NODE_ENV, PORT, DATABASE_URL,
# FRONTEND_ORIGIN (https://DOMAIN), TRUST_PROXY_HOPS.
