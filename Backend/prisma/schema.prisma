generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

//
// ════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════
//

enum Role {
  admin
  professor
  student
}

enum UserStatus {
  active
  suspended
}

/// Optional on the account: it decides the default avatar when the
/// administration has not uploaded a photo. Absent stays valid.
enum Gender {
  male
  female
}

enum AcademicLevel {
  licence
  master
  doctorate
}

enum TopicStatus {
  pending
  approved
  rejected
  open
  full
  archived
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

// Status of a whole-group request submitted by a student leader and
// reviewed by the administration.
enum GroupRequestStatus {
  pending
  accepted
  rejected
}

enum MilestoneStatus {
  pending
  in_progress
  completed
  overdue
}

enum DefenseStatus {
  scheduled
  completed
  cancelled
}

enum CommitteeRole {
  president
  supervisor
  examiner
}

enum NotificationType {
  application_accepted
  application_rejected
  topic_approved
  topic_rejected
  milestone_due
  milestone_feedback
  defense_scheduled
  defense_graded
  general
  /// دخولٌ إلى الحساب من جهازٍ لم يُرَ عليه من قبل.
  security_alert
}

//
// ════════════════════════════════════════════════════════════
//  USERS
// ════════════════════════════════════════════════════════════
//

model User {
  id String @id @default(uuid())

  firstName String?
  lastName  String?

  /// الاسم كما يُكتب بالحروف اللاتينية في الوجه الفرنسيّ للوثائق الرسمية.
  /// لا يُشتقّ من العربي — «حمادي» قد تكون Hamadi أو Hammadi — فيُدخَل كما
  /// هو في وثائق صاحبه. واختياريّ: من لا اسم لاتينيّ له يُعرض باسمه العربي.
  firstNameLatin String?
  lastNameLatin  String?

  email         String? @unique
  /// The address its owner proved theirs, by opening a link sent to it
  /// (modules/auth/email-links). Mail that can take over an account — a
  /// password reset — goes to `email` only while the two are the same: an
  /// address changed, or mistyped by whoever entered it, is not trusted until
  /// proven again. Nothing else has to remember to clear it.
  verifiedEmail String? @db.VarChar(191)
  username      String? @unique

  password String

  phone     String?
  avatarUrl String?
  gender    Gender?

  role   Role
  status UserStatus @default(active)

  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  /// Bumped on logout / forced sign-out. Tokens carrying an older value are
  /// rejected, which is what makes logout and "revoke everywhere" real.
  tokenVersion Int @default(0)

  /// كلمة مرورٍ سلّمتها الإدارة — تاريخ ميلاد، أو مولَّدة في الاستيراد، أو
  /// أُعيد تعيينها. يعرفها غيرُ صاحبها، فلا يُفتح من الحساب شيءٌ حتى يختار
  /// صاحبه غيرها (core/middleware/auth.middleware).
  mustChangePassword Boolean @default(false)

  /// التحقّق بخطوتين (TOTP — RFC 6238). السرّ مشفَّرٌ بمفتاحٍ مشتقٍّ من
  /// SESSION_SECRET (core/auth/secret-box): نسخةٌ من القاعدة وحدها لا تكفي.
  /// `totpPendingSecret` سرٌّ قيد الإعداد لم يُثبت برمزٍ بعد.
  totpSecret        String?   @db.VarChar(255)
  totpPendingSecret String?   @db.VarChar(255)
  totpEnabledAt     DateTime?
  /// آخر خطوةٍ زمنيةٍ (٣٠ ثانية) قُبل رمزها — فلا يُقبل الرمز نفسه مرّتين.
  totpLastStep      Int?
  /// بصمات (SHA-256) رموز الاسترداد التي لم تُستعمل بعد.
  totpRecoveryCodes Json?

  /// طلب التوثيق (صورتا البطاقة والوجه)، إن أُرسل ولم يُقبل بعد.
  activationRequest ActivationRequest?

  /// «نسيت كلمة المرور» لطالبٍ بلا بريدٍ مؤكَّد: طلبٌ إلى الإدارة (modules/password-request).
  passwordRequest PasswordRequest?

  devices UserDevice[]

  student   Student?
  professor Professor?

  submissions   Submission[]
  notifications Notification[]

  sentMessages     Message[]           @relation("SentMessages")
  receivedMessages MessageRecipient[]  @relation("ReceivedMessages")
  messageUploads   MessageAttachment[] @relation("MessageUploads")
  emailTokens      EmailToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id          String              @id @default(uuid())
  senderId    String
  sender      User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  subject     String?
  body        String              @db.Text
  broadcast   String? // "all" | "students" | "professors" | "students:<specId>"
  /// The conversation this message belongs to: the id of its first message.
  /// NULL on a first message, so a conversation is `id = X OR threadId = X`.
  threadId    String?
  /// The message this one answers, when it is a reply.
  replyToId   String?
  /// When its sender last changed its text — possible for a short while
  /// after sending (modules/messages: EDIT_WINDOW_MS). Shown as "edited".
  editedAt    DateTime?
  createdAt   DateTime            @default(now())
  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  @@index([senderId])
  @@index([createdAt])
  @@index([threadId])
}

/// A file sent with a message (modules/messages/attachments).
///
/// Kept in a private folder that is never served as static files: only the
/// sender and the recipients of its message open it, through the API.
///
/// Uploaded before the message is sent, so `messageId` is empty until then.
/// An upload never sent — or whose message is gone — is swept after a day,
/// file and all. `SetNull` on both relations is what lets the sweep find it.
model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId String?
  uploader   User?    @relation("MessageUploads", fields: [uploaderId], references: [id], onDelete: SetNull)
  /// The name it was sent with: shown, and offered on download. Never used on disk.
  fileName   String   @db.VarChar(255)
  /// Its name on disk: random, holding nothing the client sent.
  storedName String   @unique @db.VarChar(64)
  /// From the server's own table of accepted types — never the client's word.
  mimeType   String   @db.VarChar(127)
  size       Int
  createdAt  DateTime @default(now())

  @@index([messageId, createdAt])
  @@index([uploaderId, messageId])
}

model MessageRecipient {
  id        String    @id @default(uuid())
  messageId String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("ReceivedMessages", fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  /// Removed from this recipient's inbox. The row stays so the sender keeps
  /// an honest recipient count and read receipt; deleting it used to make a
  /// message "sent to 3" quietly become "sent to 2".
  deletedAt DateTime?

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([userId, deletedAt])
}

//
// ════════════════════════════════════════════════════════════
//  FACULTIES
// ════════════════════════════════════════════════════════════
//

model Faculty {
  id        String  @id @default(uuid())
  name      String
  /// الاسم بالحروف اللاتينية (الإنجليزية أو الفرنسية، كما تكتبه الكلّية) —
  /// لترويسة قائمة المواضيع حين تُطبع بغير العربية.
  nameLatin String? @db.VarChar(191)
  code      String  @unique
  /// Optional cover image shown behind this entry's card.
  coverUrl  String?
  /// Optional square mark shown in place of the default building glyph.
  /// Separate from `coverUrl`: the cover is a wide backdrop, this is the
  /// faculty's own emblem and is read at 40-60px.
  iconUrl   String?

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DOMAINS (الميادين) — القسم يضمّ ميادين، والميدان يضمّ شُعبًا
// ════════════════════════════════════════════════════════════
//
model Domain {
  id String @id @default(uuid())

  name     String
  code     String  @unique
  /// Optional cover image shown behind this entry's card.
  coverUrl String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  filieres Filiere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DEPARTMENTS
// ════════════════════════════════════════════════════════════
//

model Department {
  id String @id @default(uuid())

  name      String
  /// الاسم بالحروف اللاتينية، كاسم الكلّية.
  nameLatin String? @db.VarChar(191)
  code      String  @unique
  /// Optional cover image shown behind this entry's card.
  coverUrl  String?

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  filieres   Filiere[]
  professors Professor[]
  /// أنواع مواضيع القسم (محاورها): الذكاء الاصطناعي، الأمن السيبراني…
  topicTypes TopicType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]
}

/// نوعُ موضوعٍ (محوره) في قسم: تضعه الإدارة، ويختار منه الأستاذ حين يقترح.
/// وفي قائمة المواضيع الرسمية يسبق رمزُه رقمَ كلّ موضوعٍ منه (AI01، IoT03)،
/// ويُلوَّن به سطره.
model TopicType {
  id String @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(80)
  /// حروف الرمز: «AI» ⇒ AI01، AI02…
  code  String @db.VarChar(8)
  /// لونه في القائمة: «#dbeafe».
  color String @db.VarChar(9)

  sortOrder Int @default(0)

  topics GraduationTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, code])
}

//
// ════════════════════════════════════════════════════════════
//  FILIERES (الشُّعب) — القسم يضمّ شُعبًا، والشعبة تضمّ تخصّصات
// ════════════════════════════════════════════════════════════
//

model Filiere {
  id String @id @default(uuid())

  name     String
  code     String  @unique
  /// Optional cover image shown behind this entry's card.
  coverUrl String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  specializations Specialization[]

  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  SPECIALIZATIONS
// ════════════════════════════════════════════════════════════
//

model Specialization {
  id String @id @default(uuid())

  name     String
  level    AcademicLevel
  /// Optional cover image shown behind this entry's card.
  coverUrl String?

  filiereId String
  filiere   Filiere @relation(fields: [filiereId], references: [id])

  students Student[]
  topics   GraduationTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  ACADEMIC YEARS
// ════════════════════════════════════════════════════════════
//

model AcademicYear {
  id String @id @default(uuid())

  title      String    @unique
  isActive   Boolean   @default(false)
  /// Closed and kept: the year's record was frozen on this day. An archived
  /// year takes no new students or topics until it is reopened.
  archivedAt DateTime?

  /// فترة اقتراح المواضيع: لا يقترح الأستاذ موضوعاً جديداً لهذه السنة قبل
  /// بدايتها ولا بعد نهايتها (وتعديل مقترحاته باقٍ له). والإدارة لا تتقيّد
  /// بها. تُحدَّد معاً أو تُترك معاً — وتركها يعني الاقتراح بلا قيدٍ زمنيّ.
  /// بداية اليوم الأوّل ونهاية اليوم الأخير بتوقيت الجامعة (core/academic/proposal-window).
  proposalsOpenAt  DateTime?
  proposalsCloseAt DateTime?

  /// مهلة اختيار المواضيع: لا يرسل الطالب طلب فريقٍ على موضوعٍ من هذه السنة
  /// قبل بدايتها ولا بعد نهايتها، ولا يسحب طلبه بعد نهايتها. والإدارة لا
  /// تتقيّد بها. بالقاعدة نفسها: أيّامٌ كاملة بتوقيت الجامعة، معاً أو لا شيء
  /// (core/academic/proposal-window).
  selectionOpenAt  DateTime?
  selectionCloseAt DateTime?

  /// عدد الطلبة في كلّ موضوعٍ من مواضيع السنة، لكلّ مستوى، تقرّره الإدارة:
  /// `{ licence?: { n, mode }, master?: …, doctorate?: … }` — `mode` «exact»
  /// بالضبط أو «max» حتى. ومستوى غائبٌ حرّ (core/academic/team-size).
  teamSizes Json?

  /// حدّ المواضيع لكلّ أستاذ في السنة: لا يرسل أكثر منه، وأقلّ لا بأس. يُحسب
  /// كلّ موضوعٍ له في السنة إلّا المرفوض؛ والإدارة لا تتقيّد به. ولا شيء: لا حدّ
  /// (core/academic/topic-quota).
  maxTopicsPerProfessor Int?

  students Student[]
  topics   GraduationTopic[]
  archive  AcademicYearArchive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A closed year, as it stood when it was closed: its figures and every record
/// — students, topics, projects, defences and grades — so the year can be read
/// back exactly, whatever later happens to the live rows.
model AcademicYearArchive {
  id String @id @default(uuid())

  academicYearId String       @unique
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  /// The full record (see `buildYearRecord`).
  snapshot Json
  /// The headline figures, for lists that should not load the whole record.
  summary  Json

  note           String? @db.Text
  archivedById   String?
  archivedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  STUDENTS
// ════════════════════════════════════════════════════════════
//

model Student {
  id String @id @default(uuid())

  registrationNumber String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  applications   TopicApplication[]
  projectMembers ProjectMember[]

  // Group requests this student leads, and memberships in others' requests.
  ledGroupRequests    GroupRequest[]       @relation("GroupRequestLeader")
  groupRequestMembers GroupRequestMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  PROFESSORS
// ════════════════════════════════════════════════════════════
//

model Professor {
  id String @id @default(uuid())

  employeeNumber  String @unique
  universityEmail String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  grade Json? // كان: grade String[] @default([])
  tags  Json? // كان: tags  String[] @default([])

  topics             GraduationTopic[]        @relation("TopicSupervisor")
  coSupervisedTopics GraduationTopic[]        @relation("TopicCoSupervisor")
  committeeMembers   DefenseCommitteeMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  GRADUATION TOPICS
// ════════════════════════════════════════════════════════════
//

model GraduationTopic {
  id String @id @default(uuid())

  title       String
  /// TEXT, not the default VARCHAR(191): the server runs without strict mode,
  /// so a longer description was cut at 191 characters without a word.
  description String @db.Text

  // Rich content for the topic detail view.
  requirements Json? // كان: requirements String[] @default([])
  objectives   Json? // كان: objectives   String[] @default([])

  status TopicStatus @default(pending)

  /// When the administration published this topic — the one piece of the
  /// decision that `status` cannot hold on its own.
  ///
  /// `status` carries two different things at once: the administration's
  /// decision (pending → approved → open, or rejected / archived) and the
  /// fact of occupancy (`full`). Writing `full` over `open` erases the
  /// decision, so nothing can tell afterwards whether the topic had been
  /// published or was merely approved. Every path out of `full` therefore
  /// guessed, and they guessed differently: rejecting the request returned
  /// the topic to `open`, dissolving the group returned it to `approved`.
  ///
  /// This column keeps that one bit safe across `full` and `archived`, so a
  /// topic returns to exactly where it was instead of to a guess. It is set
  /// on publish, cleared on unpublish, and read only when recomputing
  /// `status` — never rendered on its own.
  publishedAt DateTime?

  // Stored as JSON: [{ "title": "...", "url": "https://..." }]
  references Json @default("[]")

  // Reason recorded when a topic is rejected (optional). TEXT, not the
  // default VARCHAR(191): a reason explained in a sentence or two is longer.
  rejectionReason String? @db.Text

  maxStudents Int

  /// كم فريقاً يطلب هذا الموضوع **معاً** قبل أن يُغلق على غيرهم.
  ///
  /// تتقدّم الفرق دون أن تنتظر قرار الإدارة في من سبقها، والموضوعُ متاحٌ ما
  /// دامت طلباته المعلّقة دون السقف. والإدارة تختار منها فريقاً واحداً، فتُلغى
  /// البقيّة ليختار أصحابها موضوعاً آخر. والطلبُ المرفوض يُفرِج عن خانته.
  ///
  /// و`NULL` تعني بلا سقف.
  maxRequests Int?

  /// عددُ الطلبات المعلّقة الآن — ما يُقاس به السقف.
  ///
  /// نسخةٌ من عدّ الصفوف لا مصدرُ حقيقة: يكتبها `computeTopicStatus` بعد
  /// كلّ تغيّرٍ في الطلبات. وإنّما وُجدت لأنّ «متاحٌ للطلب» يُسأل عنه في
  /// استعلامٍ واحد بترقيمٍ وعدّ — وذلك يحتاج مقارنتها بـ`maxRequests` في
  /// قاعدة البيانات نفسها.
  pendingRequestCount Int @default(0)

  professorId String
  professor   Professor @relation("TopicSupervisor", fields: [professorId], references: [id])

  /// المشرف المساعد: أستاذٌ من المنصّة غيرُ المشرف. وحذفُ حسابه يتركه فارغاً.
  coSupervisorId String?
  coSupervisor   Professor? @relation("TopicCoSupervisor", fields: [coSupervisorId], references: [id], onDelete: SetNull)

  /// وصفٌ قصير — سطرٌ أو سطران — للقوائم والقائمة الرسمية؛ والوصف الكامل في `description`.
  summary String? @db.VarChar(300)

  /// نوعه (محوره) من أنواع قسم تخصّصه. ونوعٌ عليه مواضيع لا يُحذف.
  typeId String?
  type   TopicType? @relation(fields: [typeId], references: [id], onDelete: Restrict)

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  applications  TopicApplication[]
  groupRequests GroupRequest[]
  projectGroup  ProjectGroup?

  /// أوراق «طلب الموافقة على الإشراف» الصادرة لهذا الموضوع.
  supervisionDocuments SupervisionDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  TOPIC APPLICATIONS
// ════════════════════════════════════════════════════════════
//

model TopicApplication {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  topicId String
  topic   GraduationTopic @relation(fields: [topicId], references: [id])

  status   ApplicationStatus @default(pending)
  priority Int

  // Reason recorded when an application is rejected (optional).
  rejectionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, topicId])
}

//
// ════════════════════════════════════════════════════════════
//  GROUP REQUESTS
//  A student leader assembles a team and submits ONE request for a
//  topic. The administration reviews members + priority, then
//  accepts (creating the ProjectGroup) or rejects.
// ════════════════════════════════════════════════════════════
//

model GroupRequest {
  id String @id @default(uuid())

  // The topic this team wants.
  topicId String
  topic   GraduationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // The responsible student (the leader who submits the request).
  leaderStudentId String
  leader          Student @relation("GroupRequestLeader", fields: [leaderStudentId], references: [id])

  // Choice priority for this topic (1 = first choice).
  priority Int @default(1)

  status          GroupRequestStatus @default(pending)
  /// TEXT: the reasons written automatically name the topic and the members
  /// (request.memberPlacedReason), and a topic title alone may take 191.
  rejectionReason String?            @db.Text

  // All team members (the leader is included here too).
  members GroupRequestMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// المرسِلُ يُعيد الطلب على الموضوع نفسه بعد الرفض.
  ///
  /// كان هنا `@@unique([leaderStudentId, topicId])`، وكان مقبولاً يوم كان
  /// الرفضُ يحذف الصفّ. فلمّا صار يُبقيه صار القيدُ يمنع إعادة الطلب إلى
  /// الأبد — والرفضُ قد يكون لنقصٍ يُستدرك، أو خطأً من الإدارة نفسها.
  ///
  /// ولا يفتح رفعُه باب التكرار: لا يكون للفريق إلّا طلبٌ حيٌّ واحد على
  /// الموضوع، و`GraduationTopic.maxRequests` يحدّ عدد الفرق المتقدّمة معاً.
  ///
  /// والفهرسُ على `leaderStudentId` يبقى: المفتاحُ الأجنبيّ إلى `Student`
  /// كان يتّكئ على الفريد المركَّب، فلو رُفع بلا بديلٍ لسقط معه.
  @@index([leaderStudentId])
}

model GroupRequestMember {
  id String @id @default(uuid())

  requestId String
  request   GroupRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  // A student appears once per request.
  @@unique([requestId, studentId])
}

//
// ════════════════════════════════════════════════════════════
//  PROJECT GROUPS
// ════════════════════════════════════════════════════════════
//

model ProjectGroup {
