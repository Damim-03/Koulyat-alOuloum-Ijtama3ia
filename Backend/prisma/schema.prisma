  topicId String          @unique
  topic   GraduationTopic @relation(fields: [topicId], references: [id])

  members    ProjectMember[]
  milestones Milestone[]
  defense    Defense?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
