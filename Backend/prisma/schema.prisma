  date            DateTime
  /// How long the session lasts — what "the room is taken" and "the jury is
  /// busy" are measured against.
  durationMinutes Int      @default(60)
  room            String
  grade           Float?

  status DefenseStatus @default(scheduled)
  notes  String?

  groupId String       @unique
  group   ProjectGroup @relation(fields: [groupId], references: [id])

  committee DefenseCommitteeMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DEFENSE COMMITTEE MEMBERS
// ════════════════════════════════════════════════════════════
//

model DefenseCommitteeMember {
  id String @id @default(uuid())

  defenseId String
  defense   Defense @relation(fields: [defenseId], references: [id], onDelete: Cascade)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  role CommitteeRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([defenseId, professorId])
}

//
// ════════════════════════════════════════════════════════════
//  NOTIFICATIONS
// ════════════════════════════════════════════════════════════
//

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(general)
  /// بالعربية — لما يقرأ الإشعار بلا لغة.
  title   String
  message String
  /// النصّ باللغات الثلاث: { ar: { title, message }, en: …, fr: … }. يكتبه
  /// الخادم من فهرس الرسائل، وتختار الواجهة منه لغة قارئه — فإشعارٌ كتبه
  /// فعلُ غيرِه يُقرأ بلغة صاحبه. وما سبق هذا العمود بلا لغات (NULL).
  i18n    Json?

  // Optional deep-link target (e.g. "/student/applications").
  link String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append this enum near the other enums:
enum CardRole {
  student
  professor
  admin
}

// Append this model at the end of the schema:
model CardTemplate {
  id String @id @default(uuid())

  // One template per role (student / professor / admin).
  role CardRole @unique

  // Visual base.
  backgroundColor String  @default("#26423D")
  textColor       String  @default("#F5EDDA")
  accentColor     String  @default("#C1965A")
  logoUrl         String? // uploaded logo
  backgroundUrl   String? // uploaded background image

  // Drag-and-drop field placements, stored as JSON:
  // [{ "field": "fullName", "x": 50, "y": 20, "fontSize": 18,
  //    "color": "#FFFFFF", "align": "center", "bold": true }, ...]
  // x / y are PERCENT (0..100) of the card box → resolution-independent.
  layout Json @default("[]")

  // Whether this template is the approved one applied to all cards.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  UNIVERSITY EMAIL DOMAINS
//  النطاقات المسموح بها في البريد الجامعي للأساتذة. تديرها الإدارة
//  من الواجهة، ويفرضها createProfessorService / updateProfessorService.
// ════════════════════════════════════════════════════════════
//

model UniversityDomain {
  id String @id @default(uuid())

  // بدون "@" — مثال: "univ-eloued.dz"
  domain String @unique

  // النطاق المقترح افتراضياً في نماذج الإضافة.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sessions signed out individually.
///
/// A denylist rather than a session table: only a logout writes here, rows are
/// pruned once the token they revoke would have expired anyway, so the table
/// stays proportional to recent logouts rather than to active users.
/// جلسة دخولٍ واحدة ورمز تحديثها الحاليّ. رمز التحديث يتبدّل مع كلّ استعمال
/// (`refreshJti`)، فإن عاد رمزٌ قديمٌ بعد تبديله فقد سُرق أحدهما: تُلغى الجلسة.
/// و`prevJti` يُقبل لحظاتٍ بعد التبديل — تبويبان يجدّدان معاً ليسا سرقة.
model AuthSession {
  /// الـ`sid` في رمزَي الجلسة.
  id String @id

  userId String

  refreshJti String   @db.VarChar(64)
  prevJti    String?  @db.VarChar(64)
  rotatedAt  DateTime @default(now())

  /// انتهاء آخر رمز تحديث صدر لها — وما بعده يُحذف.
  expiresAt DateTime

  /// الجهاز الذي فُتحت منه — ليعرف صاحب الحساب هاتفه وحاسوبه في قائمة
  /// الجلسات. يُحفظ النصّ الخام ويُقرأ عند العرض (core/auth/device).
  userAgent String? @db.VarChar(512)
  /// آخر عنوانٍ جدّد منه رمزه.
  ip        String? @db.VarChar(64)

  /// آخر طلبٍ مرّ بها — يُكتب لجلسات الإدارة وحدها (مرّةً في الدقيقة على
  /// الأكثر)، فتنتهي الجلسة المتروكة من الخادم نفسه لا من المتصفّح وحده.
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// الأجهزة التي دخل منها الحساب. كلّ متصفّحٍ يحمل معرّفاً عشوائياً في كعكةٍ
/// طويلة العمر (core/auth/device-cookie)؛ فإن دخل الحساب من متصفّحٍ لم يُرَ
/// قبلُ — وله أجهزةٌ سابقة — نُبِّه صاحبه.
model UserDevice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// بصمة (SHA-256) معرّف المتصفّح — لا المعرّف نفسه.
  deviceKey String @db.VarChar(64)

  userAgent String? @db.VarChar(512)
  ip        String? @db.VarChar(64)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceKey])
}

/// سجلّ العمليات: كلّ ما غيّرته الإدارة، وكلّ حدثٍ يمسّ أمن الحسابات (دخول
/// المسؤولين، كلمات المرور، التحقّق بخطوتين، الخروج من الأجهزة). يُكتب ولا
/// يُعدَّل ولا يُحذف من الواجهة. ولا علاقة له بجدول المستخدمين: يبقى السطر
/// وإن حُذف صاحبه، ومعه اسمه كما كان (`actorLabel`).
model AuditLog {
  id String @id @default(uuid())

  actorId    String? @db.VarChar(64)
  actorRole  String? @db.VarChar(20)
  actorLabel String? @db.VarChar(191)

  /// `auth.login`، `password.changed`، … أو للتعديلات: `POST /students/:id`.
  action String @db.VarChar(120)

  targetType  String? @db.VarChar(40)
  targetId    String? @db.VarChar(64)
  /// ما وقعت عليه العملية كما يُسمّى (اسم الطالب، عنوان الموضوع…) — يبقى بعد حذفه.
  targetLabel String? @db.VarChar(191)

  /// ما يوضّح العملية — بلا كلمات مرورٍ ولا رموزٍ ولا أسرار (core/audit).
  details Json?

  /// نجحت أم لا — لمحاولات الدخول المرفوضة.
  success Boolean @default(true)

  ip        String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)

  /// أين العنوان — من قواعد DB-IP على الخادم نفسه (core/geo)، يوم كُتب الصفّ.
  country String? @db.VarChar(2)
  region  String? @db.VarChar(100)
  city    String? @db.VarChar(100)
  /// شبكة العنوان: اتصالات الجزائر، Djezzy، Mobilis…
  isp     String? @db.VarChar(120)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorRole, createdAt])
  @@index([ip, createdAt])
  @@index([country, createdAt])
}

enum ActivationRequestStatus {
  pending
  rejected
}

/// التوثيق (modules/activation): صوّر الطالب بطاقته ووجهه وهو يمسكها؛ فيقارن
/// المسؤول الوجه بصورة البطاقة، فيقبل — فيُوثَّق الحساب (`User.isVerified`) —
/// أو يرفض بسبب. طلبٌ واحد لكلّ حساب: إرسالٌ جديد يحلّ محلّ القائم.
///
/// الصورتان خاصّتان: في مجلّدٍ لا يُخدَم للعموم، يقرؤهما المسؤول وحده، وتُحذفان
/// عند القرار — أو بعد مدّةٍ إن لم يُراجَع الطلب.
model ActivationRequest {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status ActivationRequestStatus @default(pending)

  /// اسما الملفّين في المجلّد الخاصّ — لا مساراهما.
  cardFile   String? @db.VarChar(64)
  selfieFile String? @db.VarChar(64)

  /// الرقم الذي قرأه متصفّح الطالب من رمز QR في صورة البطاقة: قرينةٌ للمراجِع، لا دليل.
  qrNumber String? @db.VarChar(32)

  rejectionReason String?   @db.Text
  decidedAt       DateTime?

  /// متى أُرسل (يتجدّد مع كلّ إرسال).
  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sentAt])
}

enum PasswordRequestStatus {
  pending
  approved
  rejected
}

/// «نسيت كلمة المرور» لطالبٍ ليس لحسابه بريدٌ مؤكَّد (modules/password-request):
/// يكتب رقم تسجيله ويصوّر بطاقته؛ فتتحقّق الإدارة أنّها بطاقته، وتكتب له كلمة
/// مرورٍ مؤقّتة — أو ترفض بسبب. ويتابع الطالب طلبه من المتصفّح الذي أرسله وحده:
/// يحمل سرّاً لا يُحفظ هنا إلّا بصمته (`tokenHash`).
///
/// كلمة المرور التي كتبها المسؤول مختومةٌ (core/auth/secret-box) حتى ينسخها
/// الطالب، ثمّ يُحذف الطلب. وهي مؤقّتة: يُطلب منه استبدالها أوّل ما يدخل.
/// طلبٌ واحد لكلّ حساب: إرسالٌ جديد يحلّ محلّ القائم.
model PasswordRequest {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 لسرّ المتصفّح الذي أرسل الطلب.
  tokenHash String @unique @db.Char(64)

  status PasswordRequestStatus @default(pending)

  /// صورة البطاقة في المجلّد الخاصّ — اسم الملفّ لا مساره؛ تُحذف عند القرار.
  cardFile String? @db.VarChar(64)
  /// الرقم الذي قرأه متصفّح الطالب من رمز QR في صورة البطاقة.
  qrNumber String? @db.VarChar(32)

  /// كلمة المرور المؤقّتة، مختومة، إلى أن ينسخها الطالب.
  sealedPassword String? @db.VarChar(512)

  rejectionReason String?   @db.Text
  decidedAt       DateTime?

  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sentAt])
}

/// محاولات الدخول الفاشلة لكلّ مُعرِّف (رقم تسجيل، بريد) — لا لكلّ عنوان IP.
/// يُحسب للمعرِّف وإن لم يكن له حساب، فلا يكشف القفلُ أيّ الحسابات موجود.
model LoginThrottle {
  /// `student:<رقم>` · `professor:<بريد>` · `admin:<بريد>`
  key String @id @db.VarChar(191)

  failures    Int       @default(0)
  /// كم مرّةً قُفل — كلّ قفلٍ ضعفُ الذي قبله، حتى سقفٍ يوميّ.
  lockCount   Int       @default(0)
  lockedUntil DateTime?

  lastFailureAt DateTime @default(now())

  @@index([lastFailureAt])
}

model RevokedSession {
  /// The `sid` claim carried by the revoked token pair.
  id String @id

  userId String

  /// Original token expiry — anything past this is safe to delete.
  expiresAt DateTime

  revokedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

//
// ════════════════════════════════════════════════════════════
//  SUPERVISION DOCUMENTS (طلب الموافقة على الإشراف)
// ════════════════════════════════════════════════════════════
//

enum SupervisionDocumentStatus {
  active
  revoked
}

/// ورقةٌ رسمية تُثبت أنّ الموضوع صار لهذه المجموعة، يوقّعها المشرف.
model SupervisionDocument {
  id String @id @default(uuid())

  /// رقم الوثيقة المقروء: `SUP-2026-000123`. غيرُ رقم تسجيل الطالب.
  documentNumber String @unique

  /// رمزُ التحقّق الطويل — عشوائيٌّ تعميةً، لا يُخمَّن.
  verificationToken String @unique

  /// الرمزُ الشريطيّ أسفل الورقة: ثلاثة عشر رقماً بصيغة EAN-13، يُمسح
  /// بقارئٍ أو يُكتب باليد في صفحة التحقّق.
  ///
  /// واختياريٌّ في المخطّط لا في الإصدار: الأوراق الصادرة قبل إضافته لا
  /// رمزَ لها، فتأخذه عند أوّل قراءة بدل أن تسقط الهجرة على جدولٍ عامر.
  barcode String? @unique

  topicId String
  topic   GraduationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  status SupervisionDocumentStatus @default(active)

  /// لقطةُ ما وقّع عليه الأستاذ: العنوان والمشرف والطلبة وأرقامهم والسنة
  /// والشهادة ونصّ الورقة، كما كانت يوم طُبعت أوّل مرّة. وقبل ذلك تتبع
  /// موضوعها ونصّ الورقة الجاري، فتُحدَّث كلّما قُرئت (انظر `printedAt`).
  ///
  /// والتحقّق يقرأ منها لا من الصفوف الحيّة: لو خرج طالبٌ من المجموعة بعد
  /// التوقيع لَقال ماسحُ الـQR إنّ الورقة الموقَّعة تخصّ طلبةً آخرين —
  /// وهي لا تخصّهم. الوثيقة شهادةٌ على لحظةٍ مضت، لا نافذةٌ على الحاضر.
  snapshot Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  /// أوّل طباعة — أو أوّل ما فُتحت نافذة طباعتها، فلا يُعرف أخرجت ورقةٌ أم لا.
  ///
  /// قبلها لا ورقة على مكتبٍ تُخالفها الشاشة: تتبع الوثيقة موضوعها ونصّ
  /// الورقة الجاري، برقمها ورمزها نفسيهما. وعندها يُثبَّت ما فيها، فلا يتغيّر
  /// بعدها شيءٌ ممّا قد يكون خرج على الورق. والصادرة قبل تسجيل الطباعة تُعدّ
  /// مطبوعةً منذ صدورها (الهجرة): لا يُعرف أطُبعت، والأسلم أنّها طُبعت.
  printedAt     DateTime?
  /// من طبعها أوّل مرّة: حسابه وصفته واسمه يومها — الاسم كما كان، كسجلّ التدقيق.
  printedById   String?
  printedByRole Role?
  printedByName String?
  /// كم مرّةً طُبعت، ومتى آخرها.
  printCount    Int       @default(0)
  lastPrintedAt DateTime?

  @@index([topicId])
  @@index([status])
}

//
// ════════════════════════════════════════════════════════════
//  HOME SLIDES (صور واجهة الصفحة الرئيسية)
// ════════════════════════════════════════════════════════════
//

/// أين تُعرض الصورة: خلف عنوان الصفحة الرئيسية، أو في معرض صفحة «عن المنصة»،
/// أو خلفيةً للوحة الترحيب في صفحة الدخول، أو خلفيةً لرأس «عن المنصة».
enum SlidePlacement {
  home
  about
  login
  aboutHero
}

/// صورةٌ تختارها الإدارة وترتّبها: خلف عنوان الصفحة الرئيسية، أو في معرض
/// «عن المنصة»، أو خلف لوحة الترحيب في صفحة الدخول، أو خلف رأس «عن المنصة»
/// (`placement`). يقرؤها الزائر بلا تسجيل دخول — فلا يُعاد منها
/// إلّا ما يُعرض. والترتيب والسقف لكلّ موضعٍ على حدة.
model HomeSlide {
  id String @id @default(uuid())

  placement SlidePlacement @default(home)

  /// مسارٌ نسبيّ من رفع الإدارة (`/uploads/cards/<file>`).
  imageUrl String @db.VarChar(2048)

  /// سطرٌ اختياريّ يُقرأ في زاوية الصورة — «حفل التخرّج ٢٠٢٦» مثلاً.
  caption String? @db.VarChar(160)

  /// المعطَّلة تبقى في القائمة ولا تظهر للزائر.
  isActive Boolean @default(true)

  /// ترتيب العرض، تصاعدياً.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, sortOrder])
}

//
// ════════════════════════════════════════════════════════════
//  NEWS (آخر الأخبار) — شريط الأخبار في الصفحة الرئيسية
// ════════════════════════════════════════════════════════════
//

/// خبرٌ في شريط «آخر الأخبار». العربية أصل، والفرنسية والإنجليزية اختياريّتان:
/// ما لم يُترجَم يُعرض بالعربية في الواجهتين الأخريين.
model NewsItem {
  id String @id @default(uuid())

  text   String  @db.VarChar(300)
  textFr String? @db.VarChar(300)
  textEn String? @db.VarChar(300)

  /// تاريخ الخبر كما يُعرض («16 مارس») — يومٌ لا لحظة.
  date DateTime @db.Date

  /// رابطٌ اختياريّ: مسارٌ داخليّ (`/topics`) أو عنوانٌ مطلق.
  linkUrl String? @db.VarChar(2048)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, date])
}

//
// ════════════════════════════════════════════════════════════
//  SITE CONTENT — نصوص الواجهة التي تحرّرها الإدارة
// ════════════════════════════════════════════════════════════
//

/// كتلةُ محتوى واحدة لكلّ مفتاح — «كلمة رئيس القسم» أوّلها.
///
/// JSON لا أعمدة: بنية الكتلة تختلف من مفتاحٍ إلى آخر، والتحقّق منها في
/// مخطّطات zod لكلّ مفتاح (`site.validation.ts`)، لا في القاعدة.
model SiteContent {
  slug String @id @db.VarChar(64)

  value Json

  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  EMAIL LINKS
// ════════════════════════════════════════════════════════════
//

enum EmailTokenPurpose {
  /// "Forgot my password": sets a new one.
  reset
  /// Proves an address belongs to the account.
  verify
}

/// A link sent by email (modules/auth/email-links). Only the SHA-256 of its
/// token is kept: a copy of the database opens no account. Good once, for a
/// short while, and only for the address it was sent to.
model EmailToken {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique @db.Char(64)
  /// The address it went to: a verification counts only while the account
  /// still has that address.
  email     String            @db.VarChar(191)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose, createdAt])
}
