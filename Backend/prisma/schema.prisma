generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════
//

enum Role {
  owner
  admin
  professor
  student
}

enum UserStatus {
  active
  suspended
}

enum AcademicLevel {
  licence
  master
  doctorate
}

enum TopicStatus {
  pending
  approved
  rejected
  open
  full
  archived
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

// Status of a whole-group request submitted by a student leader and
// reviewed by the administration.
enum GroupRequestStatus {
  pending
  accepted
  rejected
}

enum MilestoneStatus {
  pending
  in_progress
  completed
  overdue
}

enum DefenseStatus {
  scheduled
  completed
  cancelled
}

enum CommitteeRole {
  president
  supervisor
  examiner
}

enum NotificationType {
  application_accepted
  application_rejected
  topic_approved
  topic_rejected
  milestone_due
  milestone_feedback
  defense_scheduled
  defense_graded
  general
}

//
// ════════════════════════════════════════════════════════════
//  USERS
// ════════════════════════════════════════════════════════════
//

model User {
  id String @id @default(uuid())

  firstName String?
  lastName  String?

  email    String? @unique
  username String? @unique

  password String

  phone     String?
  avatarUrl String?

  role   Role
  status UserStatus @default(active)

  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  student   Student?
  professor Professor?

  submissions   Submission[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  FACULTIES
// ════════════════════════════════════════════════════════════
//

model Faculty {
  id   String @id @default(uuid())
  name String
  code String @unique

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DOMAINS (الميادين) — القسم يضمّ ميادين، والميدان يضمّ شُعبًا
// ════════════════════════════════════════════════════════════
//
model Domain {
  id String @id @default(uuid())

  name String
  code String @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

   filieres Filiere[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DEPARTMENTS
// ════════════════════════════════════════════════════════════
//

model Department {
  id String @id @default(uuid())

  name String
  code String @unique

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  filieres   Filiere[]
  professors Professor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]
}

//
// ════════════════════════════════════════════════════════════
//  FILIERES (الشُّعب) — القسم يضمّ شُعبًا، والشعبة تضمّ تخصّصات
// ════════════════════════════════════════════════════════════
//

model Filiere {
  id String @id @default(uuid())

  name String
  code String @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  specializations Specialization[]

  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  SPECIALIZATIONS
// ════════════════════════════════════════════════════════════
//

model Specialization {
  id String @id @default(uuid())

  name  String
  level AcademicLevel

  filiereId String
  filiere   Filiere @relation(fields: [filiereId], references: [id])

  students Student[]
  topics   GraduationTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  ACADEMIC YEARS
// ════════════════════════════════════════════════════════════
//

model AcademicYear {
  id String @id @default(uuid())

  title    String  @unique
  isActive Boolean @default(false)

  students Student[]
  topics   GraduationTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  STUDENTS
// ════════════════════════════════════════════════════════════
//

model Student {
  id String @id @default(uuid())

  registrationNumber String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  applications   TopicApplication[]
  projectMembers ProjectMember[]

  // Group requests this student leads, and memberships in others' requests.
  ledGroupRequests    GroupRequest[]       @relation("GroupRequestLeader")
  groupRequestMembers GroupRequestMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  PROFESSORS
// ════════════════════════════════════════════════════════════
//

model Professor {
  id String @id @default(uuid())

  employeeNumber  String @unique
  universityEmail String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  grade String[] @default([]) // الرتبة — free tags entered by the admin
  tags  String[] @default([]) // الصفة — free tags entered by the admin

  topics           GraduationTopic[]
  committeeMembers DefenseCommitteeMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  GRADUATION TOPICS
// ════════════════════════════════════════════════════════════
//

model GraduationTopic {
  id String @id @default(uuid())

  title       String
  description String

  // Rich content for the topic detail view.
  requirements String[] @default([])
  objectives   String[] @default([])

  status TopicStatus @default(pending)

  // Stored as JSON: [{ "title": "...", "url": "https://..." }]
  references Json @default("[]")

  // Reason recorded when a topic is rejected (optional).
  rejectionReason String?

  maxStudents Int

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  applications  TopicApplication[]
  groupRequests GroupRequest[]
  projectGroup  ProjectGroup?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  TOPIC APPLICATIONS
// ════════════════════════════════════════════════════════════
//

model TopicApplication {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  topicId String
  topic   GraduationTopic @relation(fields: [topicId], references: [id])

  status   ApplicationStatus @default(pending)
  priority Int

  // Reason recorded when an application is rejected (optional).
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, topicId])
}

//
// ════════════════════════════════════════════════════════════
//  GROUP REQUESTS
//  A student leader assembles a team and submits ONE request for a
//  topic. The administration reviews members + priority, then
//  accepts (creating the ProjectGroup) or rejects.
// ════════════════════════════════════════════════════════════
//

model GroupRequest {
  id String @id @default(uuid())

  // The topic this team wants.
  topicId String
  topic   GraduationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // The responsible student (the leader who submits the request).
  leaderStudentId String
  leader          Student @relation("GroupRequestLeader", fields: [leaderStudentId], references: [id])

  // Choice priority for this topic (1 = first choice).
  priority Int @default(1)

  status          GroupRequestStatus @default(pending)
  rejectionReason String?

  // All team members (the leader is included here too).
  members GroupRequestMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A leader can submit only one request per topic.
  @@unique([leaderStudentId, topicId])
}

model GroupRequestMember {
  id String @id @default(uuid())

  requestId String
  request   GroupRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  // A student appears once per request.
  @@unique([requestId, studentId])
}

//
// ════════════════════════════════════════════════════════════
//  PROJECT GROUPS
// ════════════════════════════════════════════════════════════
//

model ProjectGroup {
  id String @id @default(uuid())

  topicId String          @unique
  topic   GraduationTopic @relation(fields: [topicId], references: [id])

  members    ProjectMember[]
  milestones Milestone[]
  defense    Defense?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  PROJECT MEMBERS
// ════════════════════════════════════════════════════════════
//

model ProjectMember {
  id String @id @default(uuid())

  groupId String
  group   ProjectGroup @relation(fields: [groupId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId])
}

//
// ════════════════════════════════════════════════════════════
//  MILESTONES
// ════════════════════════════════════════════════════════════
//

model Milestone {
  id          String          @id @default(uuid())
  title       String
  description String?
  deadline    DateTime
  status      MilestoneStatus @default(pending)
  order       Int

  groupId String
  group   ProjectGroup @relation(fields: [groupId], references: [id])

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  SUBMISSIONS
// ════════════════════════════════════════════════════════════
//

model Submission {
  id String @id @default(uuid())

  fileUrl  String
  fileName String
  fileSize Int?
  mimeType String?
  version  Int

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DEFENSES
// ════════════════════════════════════════════════════════════
//

model Defense {
  id String @id @default(uuid())

  date  DateTime
  room  String
  grade Float?

  status DefenseStatus @default(scheduled)
  notes  String?

  groupId String       @unique
  group   ProjectGroup @relation(fields: [groupId], references: [id])

  committee DefenseCommitteeMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ════════════════════════════════════════════════════════════
//  DEFENSE COMMITTEE MEMBERS
// ════════════════════════════════════════════════════════════
//

model DefenseCommitteeMember {
  id String @id @default(uuid())

  defenseId String
  defense   Defense @relation(fields: [defenseId], references: [id], onDelete: Cascade)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  role CommitteeRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([defenseId, professorId])
}

//
// ════════════════════════════════════════════════════════════
//  NOTIFICATIONS
// ════════════════════════════════════════════════════════════
//

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(general)
  title   String
  message String

  // Optional deep-link target (e.g. "/student/applications").
  link String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append this enum near the other enums:
enum CardRole {
  student
  professor
  admin
}

// Append this model at the end of the schema:
model CardTemplate {
  id String @id @default(uuid())

  // One template per role (student / professor / admin).
  role CardRole @unique

  // Visual base.
  backgroundColor String  @default("#26423D")
  textColor       String  @default("#F5EDDA")
  accentColor     String  @default("#C1965A")
  logoUrl         String? // uploaded logo
  backgroundUrl   String? // uploaded background image

  // Drag-and-drop field placements, stored as JSON:
  // [{ "field": "fullName", "x": 50, "y": 20, "fontSize": 18,
  //    "color": "#FFFFFF", "align": "center", "bold": true }, ...]
  // x / y are PERCENT (0..100) of the card box → resolution-independent.
  layout Json @default("[]")

  // Whether this template is the approved one applied to all cards.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
