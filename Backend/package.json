{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"npx tsx src/server.ts\"",
    "build": "tsc && node scripts/copy-generated.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:run": "jest",
    "test:cov": "jest --coverage",
    "test:db": "dotenv -e .env.test -- prisma migrate deploy",
    "endpoints": "npx tsx scripts/endpoint-coverage.ts",
    "start": "node dist/server.js",
    "release": "prisma generate && npm run build && prisma migrate deploy",
    "seed": "npx tsx src/seeders/role.seeder.ts",
    "audit:topics": "npx tsx scripts/audit-topic-invariant.ts",
    "backfill:leaders": "npx tsx scripts/backfill-project-leaders.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "audit:prod": "npm audit --omit=dev",
    "dev:e2e": "dotenv -e .env.test -v PORT=3000 -v CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 -- npx tsx src/server.ts",
    "e2e:seed": "npx tsx scripts/e2e-fixture.ts seed",
    "e2e:teardown": "npx tsx scripts/e2e-fixture.ts teardown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.0",
    "jest": "^30.5.1",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
