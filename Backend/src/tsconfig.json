{
  // للمحرّر وحده — ولاختبارات `src` وحدها.
  //
  // الاختبارات الملاصقة (`*.test.ts` بجوار ما تختبره) مستبعَدةٌ من
  // `tsconfig.json` لئلّا تُبنى إلى `dist`، فكانت تسقط — كأخواتها في
  // `tests/` — في مشروعٍ مُستنتَج بلا أنواع jest.
  //
  // و`include` مقصورٌ على الاختبارات عمداً: ملفّات الإنتاج لا يشملها هذا
  // المشروع، فيواصل `tsserver` صعوده إلى `tsconfig.json` ويقرؤها بإعداد
  // البناء نفسه — بـ`types: ["node"]` وحدها. فيبقى ما يحرسه ذلك الحصر
  // قائماً: `expect` في ملفّ إنتاجٍ خطأٌ في المحرّر كما هو خطأٌ في
  // `npm run typecheck`.
  //
  // أمّا `types/` فتدخل معها لازمةً لا زيادة: فيها `express.d.ts` الذي يزيد
  // `req.user` على نوع Express. وهو في `tsconfig.json` يدخل ضمن `src/**/*`،
  // فلو غاب هنا لظهر خطأٌ كاذبٌ في كل ملفٍّ يقرأ `req.user` ممّا تستورده
  // الاختبارات — وهو ما ظهر فعلاً قبل إضافته.
  "extends": "../tsconfig.test.json",
  "include": ["**/*.test.ts", "types/**/*"]
}
