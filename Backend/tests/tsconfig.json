{
  // للمحرّر وحده.
  //
  // `tsserver` لا يبحث إلّا عن ملفٍّ اسمه `tsconfig.json` صعوداً من الملفّ
  // المفتوح. و`tsconfig.test.json` صحيحٌ تماماً — لكن لا أحد يعثر عليه، وهذا
  // المجلّد مستبعَدٌ من `tsconfig.json`، فتسقط ملفّاته في «مشروعٍ مُستنتَج»
  // بلا أنواع jest: خطٌّ أحمر تحت كل `describe` و`expect` و`beforeAll`.
  // وضجيجٌ بهذا الحجم لا يُزعج فحسب، بل يُخفي الخطأ الحقيقيّ حين يقع.
  //
  // فهذا الملفّ لا يضيف إعداداً ولا يُغيّر منه شيئاً؛ يدلّ المحرّر على
  // الإعداد القائم لا غير. والبناء لا يمرّ به — يُشغَّل من جذر Backend
  // فيلتقط `tsconfig.json` — ولا `jest`: يُمرَّر `tsconfig.test.json`
  // صراحةً في `jest.config.js`.
  "extends": "../tsconfig.test.json"
}
