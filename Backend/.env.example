# ============================================================
# BACKEND ENVIRONMENT — template only. Never commit a real .env.
# ============================================================
#
# Generate each secret separately (never reuse one for two variables):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# In production the process REFUSES TO START if any secret below is
# missing, shorter than 32 characters, or left at a placeholder value.

NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────────
# Required in production.
DATABASE_URL="mysql://user:password@host:3306/database"

# ── JWT ─────────────────────────────────────────────────────
# MUST be two different values. If they matched, a refresh token would
# also work as an access token and the 15-minute expiry would be moot.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Pinned into every token and checked on verification.
JWT_ISSUER=koulyat-ouloum-api
JWT_AUDIENCE=koulyat-ouloum-client

# ── Session ─────────────────────────────────────────────────
SESSION_SECRET=
SESSION_EXPIRES_IN=1d

# ── Origins ─────────────────────────────────────────────────
# The address users type in the browser: scheme + host (+ port if not the
# default), e.g. https://memoires.univ-eloued.dz. Production allows exactly
# this and nothing else, and REFUSES TO START when it is missing or is not an
# http(s) address. A trailing slash or path is dropped automatically.
FRONTEND_ORIGIN=http://localhost:5173
# Several addresses (with and without www, an IP…): comma-separated. Takes
# precedence over FRONTEND_ORIGIN.
# CORS_ORIGINS=https://memoires.univ-eloued.dz,https://www.memoires.univ-eloued.dz

# ── Reverse proxy ───────────────────────────────────────────
# Number of proxies between the internet and this process.
#   0 = directly exposed        1 = one Nginx / Cloudflare layer
# Setting this too high lets a client forge X-Forwarded-For and
# bypass every per-IP rate limit. Too low (0 behind Nginx) and every user
# shares the proxy's IP — the server logs a WARNING when it sees that.
TRUST_PROXY_HOPS=0

# ── Limits ──────────────────────────────────────────────────
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=256kb

# bcrypt cost factor. 12 is the current recommendation; raising it does
# not invalidate existing password hashes.
BCRYPT_ROUNDS=12

# Refresh-token cookie (web client). "lax" when the frontend and the API share
# a site (same domain or subdomains); "none" for unrelated domains (HTTPS only).
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_PATH=/api/auth
# HTTPS-only cookie. "auto" (default) marks it Secure when the request came
# over HTTPS — directly or via a proxy sending X-Forwarded-Proto: https — and
# leaves it usable on a plain-HTTP intranet. true/false pin it.
# AUTH_COOKIE_SECURE=auto

# ── Refused sign-ins ────────────────────────────────────────
# Every administrator is alerted when sign-in fails on this many different
# accounts within the window — a guessing run spread over many accounts,
# which neither the per-account lock nor the per-address limit sees. At most
# one alert per cooldown. Nothing is blocked; the administration decides.
# LOGIN_SPIKE_ACCOUNTS=50
# LOGIN_SPIKE_WINDOW_MINUTES=10
# LOGIN_SPIKE_COOLDOWN_MINUTES=60
# Refused sign-ins in the audit log name what was typed (a registration
# number, an email) and the address: deleted after this many days.
# FAILED_SIGNIN_RETENTION_DAYS=90
# Students and professors signing in and out are in the audit log too (an
# administrator's are kept for good): deleted after this many days.
# SIGNIN_RETENTION_DAYS=90
# Where each address in the audit log is (country, wilaya, city, network),
# read on this server from DB-IP's databases — see Backend/geo/README.md.
# Default: Backend/geo. Empty turns it off.
# GEOIP_DIR=
# A short check the browser solves (about a second) before a sign-in, asked
# only after this many failures on the account, or while the alert above is
# up. Self-hosted (ALTCHA): nothing leaves this server. Browsers can run it on
# HTTPS (or localhost) only, so "auto" turns it on when FRONTEND_ORIGIN /
# CORS_ORIGINS are all HTTPS, and leaves it off on a plain-HTTP intranet.
# LOGIN_CAPTCHA=auto
# LOGIN_CAPTCHA_AFTER_FAILURES=2

# ── Student activation ──────────────────────────────────────
# A student's first password is a birth date, printed on their own card, and
# must be replaced first. On (true), the first sign-in has a second stage: two
# photos — the card, and the student's face — that an administrator (admin page
# «تفعيل الحسابات») reviews to mark the account verified. The student may skip
# it; the account works unverified. Off by default.
# REQUIRE_STUDENT_ACTIVATION=false
# The photos are kept in Backend/storage/activation — private, never served —
# and deleted once the request is decided, or after this many days without a
# decision.
# ACTIVATION_REQUEST_DAYS=30
# A student without a confirmed email who forgot the password asks the
# administration from «نسيت كلمة المرور» with a photo of the card (kept in
# Backend/storage/password-requests, private). Not decided in this many days,
# the request goes; the password an administrator wrote waits this many hours
# for the student to copy it.
# PASSWORD_REQUEST_DAYS=14
# PASSWORD_PICKUP_HOURS=72

# ── Administrator accounts ──────────────────────────────────
# SESSION_SECRET above also encrypts each administrator's two-step
# verification key. Changing it later makes those keys unreadable: every
# administrator then needs `npm run reset-2fa` (ADMIN_EMAIL=…) and sets it up
# again.
#
# Two-step verification (authenticator app) is required of every
# administrator. Leave this on; only the test environment turns it off.
# REQUIRE_ADMIN_2FA=true
# The name authenticator apps show above the code.
# TOTP_ISSUER=Mudhakkirati
# An administrator's session ends this many hours after sign-in…
# ADMIN_SESSION_HOURS=8
# …and after this many minutes without a request (checked by the server).
# ADMIN_IDLE_MINUTES=30

# ── Outgoing mail (password reset, security alerts) ─────────
# Any SMTP server. Without SMTP_HOST mail is off: "forgot my password" says
# so, and no alert is emailed. Mail that could take over an account goes only
# to an address its owner proved theirs (a link sent to it) — a professor's
# university address counts as proven.
#
# The university's server (best: official sender, rarely marked as spam):
#   SMTP_HOST=mail.univ-eloued.dz   SMTP_PORT=587   SMTP_SECURE=false
#
# A Gmail account, for testing (a few hundred messages a day at most):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password: https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#      SMTP_USER=the.account@gmail.com  SMTP_PASS=the 16-letter app password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# The sender people see. Defaults to SMTP_USER.
# MAIL_FROM="Mudhakkirati <noreply@univ-eloued.dz>"
# Links in the mail open FRONTEND_ORIGIN (above). How long they work:
# RESET_LINK_MINUTES=30
# VERIFY_LINK_HOURS=24
