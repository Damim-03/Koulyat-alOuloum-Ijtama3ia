# ============================================================
# BACKEND ENVIRONMENT — template only. Never commit a real .env.
# ============================================================
#
# Generate each secret separately (never reuse one for two variables):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# In production the process REFUSES TO START if any secret below is
# missing, shorter than 32 characters, or left at a placeholder value.

NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────────
# Required in production.
DATABASE_URL="mysql://user:password@host:3306/database"

# ── JWT ─────────────────────────────────────────────────────
# MUST be two different values. If they matched, a refresh token would
# also work as an access token and the 15-minute expiry would be moot.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Pinned into every token and checked on verification.
JWT_ISSUER=koulyat-ouloum-api
JWT_AUDIENCE=koulyat-ouloum-client

# ── Session ─────────────────────────────────────────────────
SESSION_SECRET=
SESSION_EXPIRES_IN=1d

# ── Origins ─────────────────────────────────────────────────
# Production allows exactly these and nothing else. Comma-separated.
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGINS=https://app.example.dz,https://www.example.dz

# This API's own public base URL, used to build upload URLs without
# trusting the request's Host header.
PUBLIC_API_URL=http://localhost:3000

# ── Reverse proxy ───────────────────────────────────────────
# Number of proxies between the internet and this process.
#   0 = directly exposed        1 = one Nginx / Cloudflare layer
# Setting this too high lets a client forge X-Forwarded-For and
# bypass every per-IP rate limit.
TRUST_PROXY_HOPS=0

# ── Limits ──────────────────────────────────────────────────
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=256kb

# bcrypt cost factor. 12 is the current recommendation; raising it does
# not invalidate existing password hashes.
BCRYPT_ROUNDS=12
